+#ifdef G_OS_UNIX
+/*
+ * Live reload of the user's gtk.css.
+ *
+ * GTK loads $XDG_CONFIG_HOME/gtk-4.0/gtk.css into the user provider once, when
+ * the display opens, and never looks at it again -- so a theme switch only
+ * reaches apps that are started afterwards, while the bar and the terminal
+ * change at once. Watch the file instead (and, if it is a symlink, the file it
+ * points at) and reload that same provider: the style cascade then restyles
+ * every open window, exactly as if the app had just been started.
+ */
+
+typedef struct
+{
+  GtkCssProvider *provider;      /* the user provider from settings_init_style() */
+  char           *path;          /* $XDG_CONFIG_HOME/gtk-4.0/gtk.css */
+  char           *target;        /* what path resolves to, when it is a symlink */
+  GFileMonitor   *path_monitor;
+  GFileMonitor   *target_monitor;
+  guint           reload_id;
+} GtkUserCssWatcher;
+
+static GtkUserCssWatcher user_css_watcher;
+
+static void     user_css_watch_target (void);
+static gboolean user_css_reload       (gpointer data);
+static void     user_css_changed      (GFileMonitor      *monitor,
+                                       GFile             *file,
+                                       GFile             *other_file,
+                                       GFileMonitorEvent  event,
+                                       gpointer           data);
+
+static GFileMonitor *
+user_css_monitor (const char *path)
+{
+  GFileMonitor *monitor;
+  GFile *file;
+
+  file = g_file_new_for_path (path);
+  monitor = g_file_monitor_file (file, G_FILE_MONITOR_WATCH_MOVES, NULL, NULL);
+  g_object_unref (file);
+
+  if (monitor)
+    g_signal_connect (monitor, "changed", G_CALLBACK (user_css_changed), NULL);
+
+  return monitor;
+}
+
+static void
+user_css_changed (GFileMonitor      *monitor,
+                  GFile             *file,
+                  GFile             *other_file,
+                  GFileMonitorEvent  event,
+                  gpointer           data)
+{
+  switch (event)
+    {
+    case G_FILE_MONITOR_EVENT_CHANGED:
+    case G_FILE_MONITOR_EVENT_CHANGES_DONE_HINT:
+    case G_FILE_MONITOR_EVENT_CREATED:
+    case G_FILE_MONITOR_EVENT_DELETED:
+    case G_FILE_MONITOR_EVENT_RENAMED:
+    case G_FILE_MONITOR_EVENT_MOVED_IN:
+    case G_FILE_MONITOR_EVENT_MOVED_OUT:
+      break;
+    default:
+      return;
+    }
+
+  /* a theme switch writes a few files in a row, so wait for it to settle */
+  if (user_css_watcher.reload_id)
+    g_source_remove (user_css_watcher.reload_id);
+  user_css_watcher.reload_id = g_timeout_add (150, user_css_reload, NULL);
+}
+
+static gboolean
+user_css_reload (gpointer data)
+{
+  user_css_watcher.reload_id = 0;
+
+  if (g_file_test (user_css_watcher.path, G_FILE_TEST_IS_REGULAR))
+    gtk_css_provider_load_from_path (user_css_watcher.provider,
+                                     user_css_watcher.path);
+  else
+    gtk_css_provider_load_from_string (user_css_watcher.provider, "");
+
+  /* the file may have been replaced by a different symlink */
+  user_css_watch_target ();
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+user_css_watch_target (void)
+{
+  char *target;
+  GFileMonitor *old;
+
+  target = realpath (user_css_watcher.path, NULL);
+  if (target && strcmp (target, user_css_watcher.path) == 0)
+    {
+      /* a plain file: the watch on the path itself already sees writes */
+      free (target);
+      target = NULL;
+    }
+
+  if (g_strcmp0 (target, user_css_watcher.target) == 0)
+    {
+      free (target);
+      return;
+    }
+
+  /* install the new watch before dropping the old one: replacing the watch on
+   * the same file in one step can leave GLib without a kernel watch */
+  old = user_css_watcher.target_monitor;
+  user_css_watcher.target_monitor = target ? user_css_monitor (target) : NULL;
+  g_free (user_css_watcher.target);
+  user_css_watcher.target = g_strdup (target);
+  free (target);
+  g_clear_object (&old);
+}
+
+static void
+user_css_watch (GtkCssProvider *provider,
+                char           *path)
+{
+  user_css_watcher.provider = provider;
+  user_css_watcher.path = path;           /* keeps the string */
+  user_css_watcher.path_monitor = user_css_monitor (path);
+  user_css_watch_target ();
+}
+#endif /* G_OS_UNIX */
+
 static void
 settings_init_style (GtkSettings *settings)
 {
@@ -1206,7 +1340,11 @@
                        G_FILE_TEST_IS_REGULAR))
         gtk_css_provider_load_from_path (css_provider, css_path);
 
